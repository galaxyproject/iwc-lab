{
 "pin": "pins/stats.galaxy-tool-pin.json",
 "in": {
  "input": "alignments",
  "addref_cond|ref": "reference_fasta",
  "when": "run_stats"
 },
 "out": [
  "output"
 ],
 "state": {
  "coverage_cond": {
   "coverage_select": "no"
  },
  "remove_dups": false,
  "split_output_cond": {
   "split_output_selector": "no"
  },
  "filter_by_flags": {
   "filter_flags": "nofilter"
  },
  "addref_cond": {
   "addref_select": "history"
  },
  "cond_region": {
   "select_region": "no"
  },
  "sparse": false,
  "remove_overlaps": false
 },
 "port_map": {
  "TODO_stats": "output"
 }
}