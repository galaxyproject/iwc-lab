      "label": "${tool.name} on ${on_string}: Nexus",
      "hidden": false,
      "type": "data",
      "format": "nexus",
      "format_source": null,
      "metadata_source": null,
      "discover_datasets": [],
      "from_work_dir": "tree.nexus",
      "precreate_directory": false
    },
    {
      "name": "phyloxml",
      "label": "${tool.name} on ${on_string}: PhyloXML",
      "hidden": false,
      "type": "data",
      "format": "phyloxml",
      "format_source": null,
      "metadata_source": null,
      "discover_datasets": [],
      "from_work_dir": "tree.phyloxml",
      "precreate_directory": false
    },
    {
      "name": "newick",
      "label": "${tool.name} on ${on_string}: Newick",
      "hidden": false,
      "type": "data",
      "format": "newick",
      "format_source": null,
      "metadata_source": null,
      "discover_datasets": [],
      "from_work_dir": "tree.newick",
      "precreate_directory": false
    },
    {
      "name": "log",
      "label": "${tool.name} on ${on_string}: scale and log",
      "hidden": false,
      "type": "data",
      "format": "txt",
      "format_source": null,
      "metadata_source": null,
      "discover_datasets": [],
      "from_work_dir": "heat-tree.log",
      "precreate_directory": false
    }
  ],
  "citations": [
    {
      "type": "doi",
      "content": "10.1093/bioinformatics/btaa070"
    }
  ],
  "license": null,
  "profile": "25.1",
  "edam_operations": [],
  "edam_topics": [],
  "xrefs": [
    {
      "value": "gappa",
      "type": "bio.tools"
    }
  ],
  "help": {
    "format": "markdown",
    "content": "\nDisplay phylogenetic placement mass on a reference tree. The default exports SVG, Nexus and PhyloXML versions of the same heat tree. Enable the optional log output to retain the exact colour scale, including its numerical limits. Newick output can be requested separately; it does not preserve graphical colour annotations.\n\nThe **Newick output options** apply only when Newick is selected. They set the number of branch length digits (default 6). They also control whether node labels with characters that are invalid in Newick are quoted or have those characters replaced by underscores (the default).\n    "
  }
}