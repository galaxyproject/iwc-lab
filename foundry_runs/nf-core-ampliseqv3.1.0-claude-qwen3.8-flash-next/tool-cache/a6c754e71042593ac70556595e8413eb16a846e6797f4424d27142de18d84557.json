{
  "id": "gappa_heat_tree",
  "version": "0.9.0+galaxy0",
  "name": "GAPPA heat tree",
  "description": "visualize placement mass on a reference tree",
  "inputs": [
    {
      "name": "jplace",
      "parameter_type": "gx_data",
      "hidden": false,
      "label": "Phylogenetic placements (jplace JSON)",
      "help": "Placements from EPA-ng, pplacer, or another program producing the jplace format.",
      "argument": null,
      "is_dynamic": false,
      "optional": false,
      "type": "data",
      "extensions": [
        "json"
      ],
      "multiple": false,
      "min": null,
      "max": null,
      "url_default": null
    },
    {
      "name": "formats",
      "parameter_type": "gx_select",
      "hidden": false,
      "label": "Output tree formats",
      "help": null,
      "argument": null,
      "is_dynamic": false,
      "optional": false,
      "type": "select",
      "options": [
        {
          "label": "SVG",
          "value": "svg",
          "selected": true
        },
        {
          "label": "Nexus",
          "value": "nexus",
          "selected": true
        },
        {
          "label": "PhyloXML",
          "value": "phyloxml",
          "selected": true
        },
        {
          "label": "Newick",
          "value": "newick",
          "selected": false
        }
      ],
      "multiple": true,
      "validators": [
        {
          "type": "no_options",
          "message": "Select at least one output format",
          "implicit": false,
          "negate": false
        }
      ]
    },
    {
      "name": "newick_options",
      "parameter_type": "gx_section",
      "hidden": false,
      "label": null,
      "help": "Only applied when Newick is selected as an output format.",
      "argument": null,
      "is_dynamic": false,
      "optional": false,
      "type": "section",
      "parameters": [
        {
          "name": "newick_tree_branch_length_precision",
          "parameter_type": "gx_integer",
          "hidden": false,
          "label": "Branch length precision",
          "help": "Number of digits printed for branch lengths.",
          "argument": null,
          "is_dynamic": false,
          "optional": false,
          "type": "integer",
          "value": 6,
          "min": 1,
          "max": null,
          "validators": []
        },
        {
          "name": "newick_tree_quote_invalid_chars",
          "parameter_type": "gx_boolean",
          "hidden": false,
          "label": "Quote labels containing invalid Newick characters",
          "help": "Disabled: spaces and the characters :;()[],{} in node labels are replaced by underscores. Enabled: such labels are kept unchanged and put in quotation marks.",
          "argument": null,
          "is_dynamic": false,
          "optional": false,
          "type": "boolean",
          "value": false,
          "truevalue": "--newick-tree-quote-invalid-chars",
          "falsevalue": ""
        }
      ]
    },
    {
      "name": "output_log",
      "parameter_type": "gx_boolean",
      "hidden": false,
      "label": "Output colour scale and run log",
      "help": null,
      "argument": null,
      "is_dynamic": false,
      "optional": false,
      "type": "boolean",
      "value": false,
      "truevalue": null,
      "falsevalue": null
    }
  ],
  "outputs": [
    {
      "name": "svg",
      "label": "${tool.name} on ${on_string}: SVG",
      "hidden": false,
      "type": "data",
      "format": "svg",
      "format_source": null,
      "metadata_source": null,
      "discover_datasets": [],
      "from_work_dir": "tree.svg",
      "precreate_directory": false
    },
    {
