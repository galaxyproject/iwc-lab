          {
            "label": "Accumulated placement weight",
            "value": "accumulated",
            "selected": false
          }
        ],
        "multiple": false,
        "validators": []
      },
      "whens": [
        {
          "discriminator": "minimum",
          "parameters": [
            {
              "name": "threshold",
              "parameter_type": "gx_float",
              "hidden": false,
              "label": "Minimum likelihood weight",
              "help": null,
              "argument": null,
              "is_dynamic": false,
              "optional": false,
              "type": "float",
              "value": 0.01,
              "min": 0,
              "max": 1,
              "validators": []
            }
          ],
          "is_default_when": true
        },
        {
          "discriminator": "accumulated",
          "parameters": [
            {
              "name": "threshold",
              "parameter_type": "gx_float",
              "hidden": false,
              "label": "Accumulated likelihood weight",
              "help": null,
              "argument": null,
              "is_dynamic": false,
              "optional": false,
              "type": "float",
              "value": 0.99,
              "min": 0,
              "max": 1,
              "validators": []
            }
          ],
