      "label": "Reference sequence alignment",
      "help": null,
      "argument": null,
      "is_dynamic": false,
      "optional": false,
      "type": "data",
      "extensions": [
        "fasta"
      ],
      "multiple": false,
      "min": null,
      "max": null,
      "url_default": null
    },
    {
