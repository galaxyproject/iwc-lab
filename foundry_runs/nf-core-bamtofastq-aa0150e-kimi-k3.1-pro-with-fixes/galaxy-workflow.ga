    "21": {
      "id": 21,
      "type": "tool",
      "label": "Convert BAM and CRAM to FASTQ",
      "name": "Convert alignment to FASTQ reads",
      "annotation": "",
      "tool_id": null,
      "tool_state": {
        "__page__": 0
      },
      "tool_representation": {
        "class": "GalaxyUserTool",
        "id": "bamtofastq_convert",
        "version": "1.0.0",
        "name": "Convert alignment to FASTQ reads",
        "description": "Reproduce nf-core/bamtofastq single-end and four-flag-class paired conversion with optional region, reference and fast collate settings.",
        "container": "community.wave.seqera.io/library/htslib_samtools:1.23.1--5b6bb4ede7e612e5",
        "shell_command": "bash convert_alignment.sh",
        "configfiles": [
          {
            "filename": "convert_alignment.sh",
            "content": "set -euo pipefail\nINPUT='$(inputs.alignment.path)'\nEXT='$(inputs.alignment.format)'\nSAMPLE='$(inputs.alignment.element_identifier)'\nFASTA='$(inputs.fasta ? inputs.fasta.path : \"\")'\nFAI='$(inputs.fai ? inputs.fai.path : \"\")'\nCHR='$(inputs.chr)'\nFAST='$(inputs.fast)'\nREADS_IN_MEMORY='$(inputs.reads_in_memory)'\nTHREADS=\"$GALAXY_SLOTS\"\nmkdir -p reads work\nif [ \"$EXT\" = 'cram' ] && [ -z \"$FASTA\" ]; then\n    echo \"CRAM input requires its reference FASTA\" >&2\n    exit 1\nfi\nln -s \"$INPUT\" \"work/input.$EXT\"\nsamtools index -@ \"$THREADS\" \"work/input.$EXT\"\nLOCAL=\"work/input.$EXT\"\nref_args=()\nif [ -n \"$FASTA\" ]; then\n    ln -s \"$FASTA\" work/reference.fasta\n    if [ -n \"$FAI\" ]; then\n        ln -s \"$FAI\" work/reference.fasta.fai\n    else\n        samtools faidx work/reference.fasta\n    fi\n    ref_args=(--reference \"$PWD/work/reference.fasta\")\nfi\nif [ \"\\$( samtools view \"\\${ref_args[@]}\" \"$LOCAL\" -@\"$THREADS\" | head -n1000 | wc -l)\" -lt \"1000\" ]; then\n    LINES_TO_CHK=\\$( samtools view \"\\${ref_args[@]}\" \"$LOCAL\" -@\"$THREADS\" | wc -l)\nelse\n    LINES_TO_CHK=1000\nfi\nif [ -n \"$CHR\" ]; then\n    samtools view --threads \"$THREADS\" \"\\${ref_args[@]}\" -hb -o \"work/chr.$EXT\" \"$LOCAL\" \"$CHR\"\n    samtools index -@ \"$THREADS\" \"work/chr.$EXT\"\n    LOCAL=\"work/chr.$EXT\"\nfi\ncollate_args=()\nif [ \"$FAST\" = 'true' ]; then\n    collate_args=(-f -r \"$READS_IN_MEMORY\")\nfi\nif [ \"\\$( { samtools view -H \"\\${ref_args[@]}\" \"$LOCAL\" -@\"$THREADS\"; samtools view \"\\${ref_args[@]}\" \"$LOCAL\" -@\"$THREADS\" | head -n\"$LINES_TO_CHK\"; } | samtools view \"\\${ref_args[@]}\" -c -f 1 -@\"$THREADS\" | awk -v lines=\"$LINES_TO_CHK\" '{print $1/lines}')\" = '1' ]; then\n    samtools view --threads \"$THREADS\" \"\\${ref_args[@]}\" -b -f1 -F12 -o work/map_map.$EXT \"$LOCAL\"\n    samtools view --threads \"$THREADS\" \"\\${ref_args[@]}\" -b -f12 -F256 -o work/unmap_unmap.$EXT \"$LOCAL\"\n    samtools view --threads \"$THREADS\" \"\\${ref_args[@]}\" -b -f4 -F264 -o work/unmap_map.$EXT \"$LOCAL\"\n    samtools view --threads \"$THREADS\" \"\\${ref_args[@]}\" -b -f8 -F260 -o work/map_unmap.$EXT \"$LOCAL\"\n    samtools merge --threads \"$THREADS\" \"\\${ref_args[@]}\" -f \"work/unmapped.$EXT\" work/unmap_unmap.$EXT work/unmap_map.$EXT work/map_unmap.$EXT\n    samtools collate \"\\${collate_args[@]}\" --threads \"$THREADS\" \"\\${ref_args[@]}\" -O work/map_map.$EXT . | samtools fastq \"\\${ref_args[@]}\" --threads \"$THREADS\" -N -0 work/mapped_other.fq.gz -1 work/mapped_1.fq.gz -2 work/mapped_2.fq.gz -s work/mapped_singleton.fq.gz\n    samtools collate \"\\${collate_args[@]}\" --threads \"$THREADS\" \"\\${ref_args[@]}\" -O \"work/unmapped.$EXT\" . | samtools fastq \"\\${ref_args[@]}\" --threads \"$THREADS\" -N -0 work/unmapped_other.fq.gz -1 work/unmapped_1.fq.gz -2 work/unmapped_2.fq.gz -s work/unmapped_singleton.fq.gz\n    cat work/mapped_1.fq.gz work/unmapped_1.fq.gz > \"reads/\\${SAMPLE}_1.merged.fastq.gz\"\n    cat work/mapped_2.fq.gz work/unmapped_2.fq.gz > \"reads/\\${SAMPLE}_2.merged.fastq.gz\"\n    ln -s \"\\${SAMPLE}_1.merged.fastq.gz\" \"reads/\\${SAMPLE}_forward.fastq.gz\"\n    ln -s \"\\${SAMPLE}_2.merged.fastq.gz\" \"reads/\\${SAMPLE}_reverse.fastq.gz\"\n    MODE=paired\nelse\n    samtools collate \"\\${collate_args[@]}\" --threads \"$THREADS\" \"\\${ref_args[@]}\" -O \"$LOCAL\" . | samtools fastq \"\\${ref_args[@]}\" --threads \"$THREADS\" -N -0 \"reads/\\${SAMPLE}_other.fq.gz\" -1 work/single_1.fq.gz -s work/single_singleton.fq.gz\n    ln -s \"\\${SAMPLE}_other.fq.gz\" \"reads/\\${SAMPLE}_unpaired.fastq.gz\"\n    MODE=single_end\nfi\nSAMTOOLS_VERSION=\\$( samtools version | sed '1!d;s/.* //')\nCAT_VERSION=\\$( cat --version 2>&1 | head -n 1 | sed 's/^.*coreutils) //; s/ .*//')\n{\n    printf 'conversion_mode: %s\\n' \"$MODE\"\n    printf 'chromosome: %s\\n' \"\\${CHR:-all}\"\n    printf 'fast_collate: %s\\n' \"$FAST\"\n    printf 'CHECKPAIREDEND:\\n  samtools: %s\\n' \"$SAMTOOLS_VERSION\"\n    printf 'SAMTOOLS_COLLATEFASTQ_SINGLE_END:\\n  samtools: %s\\n' \"$SAMTOOLS_VERSION\"\n    printf 'COLLATE_FASTQ_MAP:\\n  samtools: %s\\n' \"$SAMTOOLS_VERSION\"\n    printf 'COLLATE_FASTQ_UNMAP:\\n  samtools: %s\\n' \"$SAMTOOLS_VERSION\"\n    printf 'CAT_FASTQ:\\n  cat: %s\\n' \"$CAT_VERSION\"\n} > conversion_log.yml\n"
          }
        ],
        "inputs": [
          {
            "name": "alignment",
            "type": "data",
            "format": [
              "bam",
              "cram"
            ],
            "label": "Indexed BAM or CRAM alignment",
            "help": "One sample per mapped invocation; the element identifier is preserved as the output sample key."
          },
          {
            "name": "fasta",
            "type": "data",
            "format": [
              "fasta"
            ],
            "label": "Reference FASTA",
            "optional": true,
            "help": "Required when CRAM decoding needs a reference; optional for BAM."
          },
          {
            "name": "fai",
            "type": "data",
            "format": [
              "fai"
            ],
            "label": "Matching reference FAI",
            "optional": true,
            "help": "Supplied or workflow-built FASTA index used by samtools where needed."
          },
          {
            "name": "chr",
            "type": "text",
            "label": "Chromosome or region",
            "value": "",
            "optional": true,
            "help": "Optional source-compatible chromosome/region expression; empty converts all reads."
          },
          {
            "name": "fast",
            "type": "boolean",
            "label": "Use fast samtools collate mode",
            "value": false,
            "help": "Enable collate -f -r with reads_in_memory."
          },
          {
            "name": "reads_in_memory",
            "type": "integer",
            "label": "Reads in memory for fast collate",
            "value": 100000,
            "help": "Number of reads buffered when fast collate is enabled."
          }
        ],
        "outputs": [
          {
            "name": "reads",
            "type": "collection",
            "collection_type": "paired_or_unpaired",
            "format": "fastqsanger.gz",
            "label": "Converted reads",
            "discover_datasets": [
              {
                "discover_via": "pattern",
                "pattern": ".*_(?P<designation>forward|reverse)\\.fastq\\.gz",
                "directory": "reads"
              },
              {
                "discover_via": "pattern",
                "pattern": ".*_(?P<designation>unpaired)\\.fastq\\.gz",
                "directory": "reads"
              }
            ]
          },
          {
            "name": "conversion_log",
            "type": "data",
            "format": "yaml",
            "from_work_dir": "conversion_log.yml",
            "label": "Conversion mode and software versions"
          }
        ],
        "help": {
          "format": "markdown",
          "content": "Groups the tightly coupled nf-core CHECKPAIREDEND, optional SAMTOOLS_CHR/index, SAMTOOLS_VIEW_MAP_MAP, SAMTOOLS_VIEW_UNMAP_UNMAP, SAMTOOLS_VIEW_UNMAP_MAP, SAMTOOLS_VIEW_MAP_UNMAP, SAMTOOLS_MERGE_UNMAP, COLLATE_FASTQ_MAP/UNMAP, SAMTOOLS_COLLATEFASTQ_SINGLE_END and CAT_FASTQ operations. Uses samtools 1.23.1 and preserves paired/unpaired structure and source output basenames. The additional forward/reverse links provide Galaxy-native pair identifiers.\n"
        }
      },
      "tool_uuid": null,
      "input_connections": {
        "alignment": [
          {
            "id": 0,
            "output_name": "output"
          }
        ],
        "fasta": [
          {
            "id": 6,
            "output_name": "output"
          }
        ],
        "fai": [
          {
            "id": 13,
            "output_name": "data_param"
          }
        ],
        "chr": [
          {
            "id": 1,
            "output_name": "output"
          }
        ],
        "fast": [
          {
            "id": 4,
            "output_name": "output"
          }
        ],
        "reads_in_memory": [
          {
            "id": 5,
            "output_name": "output"
          }
        ]
      },
      "post_job_actions": {},
      "position": {
        "top": 200,
        "left": 200
      },
      "inputs": [],
      "outputs": [],
      "workflow_outputs": [
        {
          "output_name": "reads",
          "label": "converted_reads"
        }
      ]
    },
    "22": {
      "id": 22,
      "type": "tool",
      "label": "Post-conversion FastQC",
      "name": "FastQC for converted FASTQ samples",
      "annotation": "",
      "tool_id": null,
      "tool_state": {
        "__page__": 0
      },
      "tool_representation": {
        "class": "GalaxyUserTool",
        "id": "bamtofastq_fastqc_collection",
        "version": "1.0.0",
        "name": "FastQC for converted FASTQ samples",
        "description": "Run FastQC once per converted single or paired sample and preserve sample and mate identifiers in HTML, ZIP, and raw-data outputs.",
        "container": "quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0",
        "shell_command": "set -euo pipefail\nSAMPLE='$(inputs.reads.name)'\nFORWARD='$(inputs.reads.elements.forward ? inputs.reads.elements.forward.path : \"\")'\nREVERSE='$(inputs.reads.elements.reverse ? inputs.reads.elements.reverse.path : \"\")'\nUNPAIRED='$(inputs.reads.elements.unpaired ? inputs.reads.elements.unpaired.path : \"\")'\nmkdir -p fastqc_out work\nif [ -n \"$FORWARD\" ]; then\n    ln -s \"$FORWARD\" \"work/\\${SAMPLE}.post_conversion_1.fastq.gz\"\n    ln -s \"$REVERSE\" \"work/\\${SAMPLE}.post_conversion_2.fastq.gz\"\n    fastqc --quiet --threads \"$GALAXY_SLOTS\" --extract --outdir fastqc_out \"work/\\${SAMPLE}.post_conversion_1.fastq.gz\" \"work/\\${SAMPLE}.post_conversion_2.fastq.gz\"\n    for MATE in 1 2; do\n        if [ \"$MATE\" = '1' ]; then DESIGNATION=forward; else DESIGNATION=reverse; fi\n        ln -s \"fastqc_out/\\${SAMPLE}.post_conversion_\\${MATE}_fastqc.html\" \"report_\\${DESIGNATION}.html\"\n        ln -s \"fastqc_out/\\${SAMPLE}.post_conversion_\\${MATE}_fastqc.zip\" \"report_\\${DESIGNATION}.zip\"\n        unzip -p \"fastqc_out/\\${SAMPLE}.post_conversion_\\${MATE}_fastqc.zip\" '*/fastqc_data.txt' > \"report_\\${DESIGNATION}.txt\"\n    done\nelse\n    ln -s \"$UNPAIRED\" \"work/\\${SAMPLE}.post_conversion.fastq.gz\"\n    fastqc --quiet --threads \"$GALAXY_SLOTS\" --extract --outdir fastqc_out \"work/\\${SAMPLE}.post_conversion.fastq.gz\"\n    ln -s \"fastqc_out/\\${SAMPLE}.post_conversion_fastqc.html\" report_unpaired.html\n    ln -s \"fastqc_out/\\${SAMPLE}.post_conversion_fastqc.zip\" report_unpaired.zip\n    unzip -p \"fastqc_out/\\${SAMPLE}.post_conversion_fastqc.zip\" '*/fastqc_data.txt' > report_unpaired.txt\nfi\n",
        "inputs": [
          {
            "name": "reads",
            "type": "data_collection",
            "collection_type": "paired_or_unpaired",
            "format": [
              "fastqsanger.gz"
            ],
            "label": "Converted reads",
            "help": "One converted sample; paired members are passed to the same FastQC invocation as in the source module."
          }
        ],
        "outputs": [
          {
            "name": "html_file",
            "type": "collection",
            "collection_type": "paired_or_unpaired",
            "format": "html",
            "label": "Per-sample FastQC HTML reports",
            "discover_datasets": [
              {
                "discover_via": "pattern",
                "pattern": "report_(?P<designation>forward|reverse)\\.html"
              },
              {
                "discover_via": "pattern",
                "pattern": "report_(?P<designation>unpaired)\\.html"
              }
            ]
          },
          {
            "name": "text_file",
            "type": "collection",
            "collection_type": "paired_or_unpaired",
            "format": "txt",
            "label": "Per-sample raw FastQC data",
            "discover_datasets": [
              {
                "discover_via": "pattern",
                "pattern": "report_(?P<designation>forward|reverse)\\.txt"
              },
              {
                "discover_via": "pattern",
                "pattern": "report_(?P<designation>unpaired)\\.txt"
              }
            ]
          },
          {
            "name": "zip_file",
            "type": "collection",
            "collection_type": "paired_or_unpaired",
            "format": "zip",
            "label": "Per-sample native FastQC ZIP archives",
            "discover_datasets": [
              {
                "discover_via": "pattern",
                "pattern": "report_(?P<designation>forward|reverse)\\.zip"
              },
              {
                "discover_via": "pattern",
                "pattern": "report_(?P<designation>unpaired)\\.zip"
              }
            ]
          }
        ],
        "help": {
          "format": "markdown",
          "content": "Runs FastQC once per sample with both mates for paired data and one input for single-end data, matching the source FASTQC module. Source-compatible names are sample.post_conversion_1/2.fastq.gz for paired reads and sample.post_conversion.fastq.gz for unpaired reads. HTML, ZIP, and raw fastqc_data outputs remain keyed by sample and forward/reverse/unpaired designation.\n"
        }
      },
      "tool_uuid": null,
      "input_connections": {
        "reads": [
          {
            "id": 21,
            "output_name": "reads"
          }
        ],
        "when": {
          "id": 2,
          "output_name": "output"
        }
      },
      "post_job_actions": {},
      "position": {
        "top": 210,
        "left": 210
      },
      "when": "$(!inputs.when)",
      "inputs": [],
      "outputs": [],
      "workflow_outputs": [
        {
          "output_name": "html_file",
          "label": "post_conversion_fastqc_html"
        },
        {
          "output_name": "text_file",
          "label": "post_conversion_fastqc_data"
        },
        {
          "output_name": "zip_file",
          "label": "post_conversion_fastqc_zip"
        }
      ]
    },
    "24": {
      "id": 24,
      "type": "tool",
      "label": "Aggregate software versions",
      "name": "Aggregate verified software versions",
      "annotation": "",
      "tool_id": null,
      "tool_state": {
        "__page__": 0
      },
      "tool_representation": {
        "class": "GalaxyUserTool",
        "id": "aggregate_software_versions",
        "version": "1.0.0",
        "name": "Aggregate verified software versions",
        "description": "Reduce mapped conversion logs to one manifest and record only evidenced package versions.",
        "container": "community.wave.seqera.io/library/htslib_samtools:1.23.1--5b6bb4ede7e612e5",
        "shell_command": "set -eu\ncp '$(inputs.conversion_logs.elements[0].path)' software_versions.yml\nprintf '%s\\n' 'FASTQC_PRE_CONVERSION:' '  fastqc: 0.12.1' 'FASTQC_POST_CONVERSION:' '  fastqc: 0.12.1' 'FASTQUTILS_INFO:' '  fastqutils: 0.25.3' 'MULTIQC:' '  multiqc: 1.34' 'SAMTOOLS_FAIDX:' '  samtools: null' 'SAMTOOLS_FLAGSTAT:' '  samtools: null' 'SAMTOOLS_IDXSTATS:' '  samtools: null' 'SAMTOOLS_STATS:' '  samtools: 1.23.1' 'wrapper_resolution:' '  fastqc: native FastQC 0.12.1 UDT' '  samtools_faidx: iuc/samtools_faidx 1.22+galaxy1' '  samtools_flagstat: devteam/samtools_flagstat 2.0.8' '  samtools_idxstats: devteam/samtools_idxstats 2.0.8' '  samtools_stats: native samtools 1.23.1 UDT' '  fastqutils: native fastqutils 0.25.3 UDT' '  multiqc: iuc/multiqc 1.34+galaxy0' >> software_versions.yml\n",
        "inputs": [
          {
            "name": "conversion_logs",
            "type": "data_collection",
            "collection_type": "list",
            "format": [
              "yaml"
            ],
            "label": "Per-sample conversion and version logs",
            "help": "Mapped logs from bamtofastq_convert; the first log supplies runtime versions shared by every sample in the same pinned container."
          }
        ],
        "outputs": [
          {
            "name": "versions",
            "type": "data",
            "format": "yaml",
            "from_work_dir": "software_versions.yml",
            "label": "Aggregated software versions and wrapper identities"
          }
        ],
        "help": {
          "format": "markdown",
          "content": "Reduces all mapped conversion logs to one dataset by using the shared container-version evidence from the first sample. Preserves exact direct-runtime versions and records unresolved wrapper packages as nulls rather than fabricating values.\n"
        }
      },
      "tool_uuid": null,
      "input_connections": {
        "conversion_logs": [
          {
            "id": 21,
            "output_name": "conversion_log"
          }
        ]
      },
      "post_job_actions": {},
      "position": {
        "top": 230,
        "left": 230
      },
      "inputs": [],
      "outputs": [],
      "workflow_outputs": [
        {
          "output_name": "versions",
          "label": "software_versions"
        }
      ]
    },
