          }
        ]
      },
      "post_job_actions": {},
      "position": {
        "top": 170,
        "left": 170
      },
      "when": "$(inputs.when == \"with_reference\")",
      "inputs": [],
      "outputs": [],
      "workflow_outputs": [],
      "tool_uuid": null,
      "tool_representation": {
        "class": "GalaxyUserTool",
        "id": "bamtofastq_samtools_stats",
        "version": "1.0.0",
        "name": "Samtools alignment statistics",
        "description": "Run the source samtools stats command with its pinned runtime and original input basenames.",
        "container": "community.wave.seqera.io/library/htslib_samtools:1.23.1--5b6bb4ede7e612e5",
        "shell_command": "set -eu\nBAM='$(inputs.alignment.basename)'\nREF='$(inputs.fasta ? inputs.fasta.basename : \"\")'\nFASTA=$(inputs.fasta ? \"'\" + inputs.fasta.path + \"'\" : \"''\")\nFAI=$(inputs.fai ? \"'\" + inputs.fai.path + \"'\" : \"''\")\nln -s '$(inputs.alignment.path)' \"$BAM\"\nif [ -n \"$FASTA\" ]; then\n    ln -s \"$FASTA\" \"$REF\"\n    if [ -n \"$FAI\" ]; then\n        ln -s \"$FAI\" \"$REF.fai\"\n    fi\n    samtools stats --threads 1 --reference \"$REF\" \"$BAM\" > alignment.stats\nelse\n    samtools stats --threads 1 \"$BAM\" > alignment.stats\nfi\n",
        "inputs": [
          {
            "name": "alignment",
            "type": "data",
            "format": [
              "bam",
              "cram"
            ],
            "label": "Indexed alignment"
          },
          {
            "name": "fasta",
            "type": "data",
            "format": [
              "fasta"
            ],
            "optional": true,
            "label": "Reference FASTA"
          },
          {
            "name": "fai",
            "type": "data",
            "format": [
              "fai"
            ],
            "optional": true,
            "label": "Matching reference FAI"
          }
        ],
        "outputs": [
          {
            "name": "output",
            "type": "data",
            "format": "tabular",
            "from_work_dir": "alignment.stats",
            "label": "Samtools statistics"
          }
        ],
        "help": {
          "format": "markdown",
          "content": "Reproduces SAMTOOLS_STATS with samtools 1.23.1, one thread (the source process_single resource setting), optional --reference, and original FASTA/alignment basenames. The latter two details are retained because samtools records its version and complete command line in the stats file, and the source nf-test snapshot compares those bytes exactly.\n"
        }
      }
    },
