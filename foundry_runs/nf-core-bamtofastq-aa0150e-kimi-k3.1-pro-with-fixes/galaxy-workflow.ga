    "15": {
      "id": 15,
      "type": "tool",
      "label": "Pre-conversion FastQC",
      "name": "FastQC for BAM and FASTQ reads",
      "annotation": "",
      "tool_id": null,
      "tool_state": {
        "__page__": 0,
        "mode": "pre_conversion"
      },
      "tool_representation": {
        "class": "GalaxyUserTool",
        "id": "bamtofastq_fastqc",
        "version": "1.0.0",
        "name": "FastQC for BAM and FASTQ reads",
        "description": "Run native FastQC with quiet threading and extract HTML, ZIP, and raw data for BAM/CRAM or FASTQ inputs.",
        "container": "quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0",
        "shell_command": "SAMPLE='$(inputs.reads.element_identifier)'\nMODE='$(inputs.mode)'\nEXT='$(inputs.mode == \"post_conversion\" ? \"fastq.gz\" : inputs.reads.format)'\nmkdir -p fastqc_out work\nln -s '$(inputs.reads.path)' \"work/\\${SAMPLE}.\\${MODE}.$EXT\"\nfastqc --quiet --threads \"$GALAXY_SLOTS\" --extract --outdir fastqc_out \"work/\\${SAMPLE}.\\${MODE}.$EXT\"\nln -s \"fastqc_out/\\${SAMPLE}.\\${MODE}_fastqc.html\" report.html\nln -s \"fastqc_out/\\${SAMPLE}.\\${MODE}_fastqc.zip\" report.zip\nunzip -p \"fastqc_out/\\${SAMPLE}.\\${MODE}_fastqc.zip\" '*/fastqc_data.txt' > fastqc_data.txt\n",
        "inputs": [
          {
            "name": "reads",
            "type": "data",
            "format": [
              "bam",
              "sam",
              "cram",
              "fastq",
              "fastqsanger",
              "fastq.gz",
              "fastqsanger.gz"
            ],
            "label": "Alignment or FASTQ dataset",
            "help": "BAM/CRAM input for pre-conversion QC, or converted FASTQ(.gz) input for post-conversion QC."
          },
          {
            "name": "mode",
            "type": "select",
            "label": "Conversion stage",
            "options": [
              {
                "label": "Pre-conversion",
                "value": "pre_conversion",
                "selected": true
              },
              {
                "label": "Post-conversion",
                "value": "post_conversion"
              }
            ],
            "help": "Controls the source-compatible basename prefix for reports."
          }
        ],
        "outputs": [
          {
            "name": "html_file",
            "type": "data",
            "format": "html",
            "from_work_dir": "report.html",
            "label": "FastQC HTML report"
          },
          {
            "name": "text_file",
            "type": "data",
            "format": "txt",
            "from_work_dir": "fastqc_data.txt",
            "label": "Raw FastQC data"
          },
          {
            "name": "zip_file",
            "type": "data",
            "format": "zip",
            "from_work_dir": "report.zip",
            "label": "Native FastQC ZIP archive"
          }
        ],
        "help": {
          "format": "markdown",
          "content": "Runs native FastQC 0.12.1 rather than forcing FASTQ mode. Input identifiers and pre_conversion/post_conversion preserve the source module's report naming conventions. The archive contains fastqc_data.txt for MultiQC aggregation.\n"
        }
      },
      "tool_uuid": null,
      "input_connections": {
        "reads": [
          {
            "id": 0,
            "output_name": "output"
          }
        ],
        "when": {
          "id": 2,
          "output_name": "output"
        }
      },
      "post_job_actions": {},
      "position": {
        "top": 140,
        "left": 140
      },
      "when": "$(!inputs.when)",
      "inputs": [],
      "outputs": [],
      "workflow_outputs": [
        {
          "output_name": "html_file",
          "label": "pre_conversion_fastqc_html"
        },
        {
          "output_name": "text_file",
          "label": "pre_conversion_fastqc_data"
        },
        {
          "output_name": "zip_file",
          "label": "pre_conversion_fastqc_zip"
        }
      ]
    },
