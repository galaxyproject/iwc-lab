    "18": {
      "id": 18,
      "type": "tool",
      "label": "Alignment statistics with reference",
      "name": "Samtools alignment statistics",
      "annotation": "",
      "tool_id": null,
      "tool_state": {
        "__page__": 0
      },
      "input_connections": {
        "when": {
          "id": 3,
          "output_name": "output"
        },
        "alignment": [
          {
            "id": 0,
            "output_name": "output"
          }
        ],
        "fasta": [
          {
            "id": 6,
            "output_name": "output"
          }
