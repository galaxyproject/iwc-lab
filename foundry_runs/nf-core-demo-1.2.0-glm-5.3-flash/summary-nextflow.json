  "workflow": {
    "name": "DEMO",
    "channels": [
      { "name": "ch_samplesheet", "source": "channel.fromList(samplesheetToList(input, \"${projectDir}/assets/schema_input.json\")).map { meta, fastq_1, fastq_2 -> ... }.groupTuple().map { samplesheet -> validateInputSamplesheet(samplesheet) }.map { meta, fastqs -> return [meta, fastqs.flatten()] }.set { ch_samplesheet }", "shape": "tuple(meta, [path,path])", "construct": "samplesheetToList", "from_param": "input", "required_runtime": true },
      { "name": "topic_versions", "source": "channel.topic(\"versions\").distinct().branch { entry -> versions_file: entry instanceof Path; versions_tuple: true }", "shape": "mixed", "construct": "topic", "from_param": null, "required_runtime": false },
      { "name": "ch_multiqc_files", "source": "channel.empty().mix(FASTQC.out.zip.map { _meta, file -> file }).mix(ch_collated_versions).mix(ch_workflow_summary.collectFile(name: 'workflow_summary_mqc.yaml')).mix(ch_methods_description.collectFile(name: 'methods_description_mqc.yaml'))", "shape": "path", "construct": "empty", "from_param": null, "required_runtime": false },
      { "name": "ch_versions", "source": "channel.empty()", "shape": "path", "construct": "empty", "from_param": null, "required_runtime": false }
    ],
    "edges": [
      { "from": "PIPELINE_INITIALISATION.out.samplesheet", "to": "FASTQC", "via": [], "notes": "samplesheet channel from the initialisation subworkflow feeds both FASTQC and SEQTK_TRIM directly" },
      { "from": "PIPELINE_INITIALISATION.out.samplesheet", "to": "SEQTK_TRIM", "via": [], "notes": "same channel; SEQTK_TRIM is gated by the params.skip_trim conditional" },
      { "from": "FASTQC.out.zip", "to": "MULTIQC", "via": ["map", "mix"], "notes": "zip files are flattened (meta dropped via map) and mixed into the multiqc_files input; MULTIQC also receives ch_collated_versions, workflow summary and methods description via collectFile" },
      { "from": "SEQTK_TRIM.out.reads", "to": "MULTIQC", "via": ["mix"], "notes": "NOTE: in the source, SEQTK_TRIM outputs feed the fq/ publish directory only; the MULTIQC input list is built from FASTQC zip and version/summary files. This edge is recorded from the topic_versions and ch_multiqc_files construction, not a direct channel read. Confidence: low." },
      { "from": "COWPY.out.txt", "to": "ch_multiqc_files", "via": [], "notes": "NOTE: COWPY outputs cowpy.txt which appears in the publish tree and stable_path snapshot, but ch_multiqc_files as written does not include COWPY.out.txt. Recorded as a source-faithfulness caveat: in the snapshot stable_content list cowpy.txt IS included in the md5 content list. Confidence: low." },
      { "from": "COWPY.out.versions_cowpy", "to": "topic_versions", "via": ["topic"], "notes": "topic: versions output aggregated into collated versions" },
      { "from": "FASTQC.out.versions_fastqc", "to": "topic_versions", "via": ["topic"], "notes": "topic: versions output aggregated into collated versions" },
      { "from": "SEQTK_TRIM.out.versions_seqtk", "to": "topic_versions", "via": ["topic"], "notes": "topic: versions output aggregated into collated versions" }
    ],
    "conditionals": [
      { "guard": "params.skip_trim", "branch": "alternate", "affects": ["SEQTK_TRIM"] }
    ]
  },
