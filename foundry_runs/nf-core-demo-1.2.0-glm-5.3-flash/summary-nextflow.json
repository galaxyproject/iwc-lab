  "params": [
    { "name": "input", "type": "string", "default": null, "description": "Path to a metadata file containing information about the samples in the experiment.", "required": true, "format": "file-path", "hidden": null, "mimetype": "text/csv", "schema_group": "Input/output options", "fa_icon": "fas fa-file-csv", "source_kind": "nextflow_schema", "source_expression": null, "source_path": null },
    { "name": "outdir", "type": "string", "default": null, "description": "The output directory where the results will be saved. You have to use absolute paths to storage on Cloud infrastructure.", "required": true, "format": "directory-path", "hidden": null, "mimetype": null, "schema_group": "Input/output options", "fa_icon": "fas fa-folder-open", "source_kind": "nextflow_schema", "source_expression": null, "source_path": null },
    { "name": "email", "type": "string", "default": null, "description": "Email address for completion summary.", "required": false, "format": null, "hidden": null, "mimetype": null, "schema_group": "Input/output options", "fa_icon": "fas fa-envelope", "source_kind": "nextflow_schema", "source_expression": null, "source_path": null },
    { "name": "multiqc_title", "type": "string", "default": null, "description": "MultiQC report title. Printed as page header, used for filename if not otherwise specified.", "required": false, "format": null, "hidden": null, "mimetype": null, "schema_group": "Input/output options", "fa_icon": "fas fa-file-signature", "source_kind": "nextflow_schema", "source_expression": null, "source_path": null },
    { "name": "genome", "type": "string", "default": null, "description": "Name of iGenomes reference.", "required": false, "format": null, "hidden": null, "mimetype": null, "schema_group": "Reference genome options", "fa_icon": "fas fa-book", "source_kind": "nextflow_schema", "source_expression": null, "source_path": null },
    { "name": "fasta", "type": "string", "default": null, "description": "Path to FASTA genome file.", "required": false, "format": "file-path", "hidden": null, "mimetype": "text/plain", "schema_group": "Reference genome options", "fa_icon": "far fa-file-code", "source_kind": "getGenomeAttribute", "source_expression": "params.fasta = getGenomeAttribute('fasta')", "source_path": "main.nf" },
    { "name": "igenomes_ignore", "type": "boolean", "default": false, "description": "Do not load the iGenomes reference config.", "required": false, "format": null, "hidden": true, "mimetype": null, "schema_group": "Reference genome options", "fa_icon": "fas fa-ban", "source_kind": "nextflow_schema", "source_expression": null, "source_path": null },
    { "name": "igenomes_base", "type": "string", "default": "s3://ngi-igenomes/igenomes/", "description": "The base path to the igenomes reference files", "required": false, "format": null, "hidden": true, "mimetype": null, "schema_group": "Reference genome options", "fa_icon": "fas fa-ban", "source_kind": "nextflow_schema", "source_expression": null, "source_path": null },
    { "name": "skip_trim", "type": "boolean", "default": false, "description": "Skip trimming fastq files with seqtk", "required": false, "format": null, "hidden": null, "mimetype": null, "schema_group": "Process skipping options", "fa_icon": "fas fa-chevron-circle-right", "source_kind": "nextflow_schema", "source_expression": null, "source_path": null },
    { "name": "multiqc_config", "type": "string", "default": null, "description": "MultiQC config file.", "required": false, "format": "file-path", "hidden": true, "mimetype": null, "schema_group": "Generic options", "fa_icon": null, "source_kind": "nextflow_schema", "source_expression": null, "source_path": null },
    { "name": "multiqc_logo", "type": "string", "default": null, "description": "Custom logo for MultiQC report.", "required": false, "format": null, "hidden": true, "mimetype": null, "schema_group": "Generic options", "fa_icon": null, "source_kind": "nextflow_schema", "source_expression": null, "source_path": null },
    { "name": "multiqc_methods_description", "type": "string", "default": null, "description": "Path to a YAML file containing methods description for MultiQC.", "required": false, "format": null, "hidden": false, "mimetype": null, "schema_group": "Generic options", "fa_icon": null, "source_kind": "nextflow_schema", "source_expression": null, "source_path": null },
    { "name": "max_multiqc_email_size", "type": "string", "default": "25.MB", "description": "Attachment size threshold in bytes for email.", "required": false, "format": null, "hidden": true, "mimetype": null, "schema_group": "Generic options", "fa_icon": null, "source_kind": "nextflow_schema", "source_expression": null, "source_path": null },
    { "name": "email_on_fail", "type": "string", "default": null, "description": "Email address for completion summary when pipeline fails.", "required": false, "format": null, "hidden": true, "mimetype": null, "schema_group": "Generic options", "fa_icon": null, "source_kind": "nextflow_schema", "source_expression": null, "source_path": null },
    { "name": "plaintext_email", "type": "boolean", "default": false, "description": "Send plain-text email instead of HTML.", "required": false, "format": null, "hidden": true, "mimetype": null, "schema_group": "Generic options", "fa_icon": null, "source_kind": "nextflow_schema", "source_expression": null, "source_path": null },
    { "name": "monochrome_logs", "type": "boolean", "default": false, "description": "Do not use coloured log outputs.", "required": false, "format": null, "hidden": true, "mimetype": null, "schema_group": "Generic options", "fa_icon": null, "source_kind": "nextflow_schema", "source_expression": null, "source_path": null },
    { "name": "help", "type": "boolean", "default": false, "description": "Display help message and exit.", "required": false, "format": null, "hidden": false, "mimetype": null, "schema_group": "Generic options", "fa_icon": null, "source_kind": "nextflow_schema", "source_expression": null, "source_path": null },
    { "name": "help_full", "type": "boolean", "default": false, "description": "Show the full help message.", "required": false, "format": null, "hidden": false, "mimetype": null, "schema_group": "Generic options", "fa_icon": null, "source_kind": "nextflow_schema", "source_expression": null, "source_path": null },
    { "name": "show_hidden", "type": "boolean", "default": false, "description": "Show hidden parameters in the help message.", "required": false, "format": null, "hidden": false, "mimetype": null, "schema_group": "Generic options", "fa_icon": null, "source_kind": "nextflow_schema", "source_expression": null, "source_path": null },
    { "name": "version", "type": "boolean", "default": false, "description": "Display version and exit.", "required": false, "format": null, "hidden": true, "mimetype": null, "schema_group": "Generic options", "fa_icon": null, "source_kind": "nextflow_schema", "source_expression": null, "source_path": null },
    { "name": "publish_dir_mode", "type": "string", "default": "copy", "description": "Method used to save pipeline results to output directory.", "required": false, "format": null, "hidden": true, "mimetype": null, "schema_group": "Generic options", "fa_icon": null, "source_kind": "nextflow_schema", "source_expression": null, "source_path": null },
    { "name": "validate_params", "type": "boolean", "default": true, "description": "Boolean whether to validate parameters against the schema at runtime.", "required": false, "format": null, "hidden": true, "mimetype": null, "schema_group": "Generic options", "fa_icon": null, "source_kind": "nextflow_schema", "source_expression": null, "source_path": null },
    { "name": "pipelines_testdata_base_path", "type": "string", "default": "https://raw.githubusercontent.com/nf-core/test-datasets/", "description": "Base URL or local path to test dataset files.", "required": false, "format": null, "hidden": true, "mimetype": null, "schema_group": "Generic options", "fa_icon": null, "source_kind": "nextflow_schema", "source_expression": null, "source_path": null },
    { "name": "trace_report_suffix", "type": "string", "default": null, "description": "Suffix to add to the trace report filename. (Computed at config-load time.)", "required": false, "format": null, "hidden": true, "mimetype": null, "schema_group": "Generic options", "fa_icon": null, "source_kind": "computed", "source_expression": "new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')", "source_path": "nextflow.config" },
    { "name": "custom_config_version", "type": "string", "default": "master", "description": "Git commit id for Institutional configs.", "required": false, "format": null, "hidden": true, "mimetype": null, "schema_group": "Institutional config options", "fa_icon": "fas fa-users-cog", "source_kind": "nextflow_schema", "source_expression": null, "source_path": null },
    { "name": "custom_config_base", "type": "string", "default": "https://raw.githubusercontent.com/nf-core/configs/master", "description": "Base directory for Institutional configs.", "required": false, "format": null, "hidden": true, "mimetype": null, "schema_group": "Institutional config options", "fa_icon": "fas fa-users-cog", "source_kind": "nextflow_schema", "source_expression": null, "source_path": null },
    { "name": "config_profile_name", "type": "string", "default": null, "description": "Institutional configs title.", "required": false, "format": null, "hidden": true, "mimetype": null, "schema_group": "Institutional config options", "fa_icon": null, "source_kind": "nextflow_schema", "source_expression": null, "source_path": null },
    { "name": "config_profile_description", "type": "string", "default": null, "description": "Institutional configs description.", "required": false, "format": null, "hidden": true, "mimetype": null, "schema_group": "Institutional config options", "fa_icon": null, "source_kind": "nextflow_schema", "source_expression": null, "source_path": null },
    { "name": "config_profile_contact", "type": "string", "default": null, "description": "Institutional configs contact email.", "required": false, "format": null, "hidden": true, "mimetype": null, "schema_group": "Institutional config options", "fa_icon": null, "source_kind": "nextflow_schema", "source_expression": null, "source_path": null },
    { "name": "config_profile_url", "type": "string", "default": null, "description": "Institutional configs URL.", "required": false, "format": null, "hidden": true, "mimetype": null, "schema_group": "Institutional config options", "fa_icon": null, "source_kind": "nextflow_schema", "source_expression": null, "source_path": null }
  ],
  "sample_sheets": [
    {
      "param": "input",
      "schema_path": "assets/schema_input.json",
      "discovered_via": "nf-schema",
      "format": "csv",
      "header": true,
      "columns": [
        { "name": "sample", "type": "string", "kind": "meta", "required": true, "default": null, "description": "Sample name; mapped to meta id via nf-schema meta annotation.", "enum": [], "pattern": "^\\S+$", "exists": null, "mimetype": null },
        { "name": "fastq_1", "type": "string", "kind": "data", "required": true, "default": null, "description": "FastQ file for reads 1.", "enum": [], "pattern": "^([\\S\\s]*\\/)?[^\\s\\/]+\\.f(ast)?q\\.gz$", "exists": true, "mimetype": null },
        { "name": "fastq_2", "type": "string", "kind": "data", "required": false, "default": null, "description": "FastQ file for reads 2 (optional; single-end when absent).", "enum": [], "pattern": "^([\\S\\s]*\\/)?[^\\s\\/]+\\.f(ast)?q\\.gz$", "exists": true, "mimetype": null }
      ]
    }
  ],
