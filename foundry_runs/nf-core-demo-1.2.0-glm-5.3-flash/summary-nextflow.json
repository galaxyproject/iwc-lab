    { "name": "docker", "kinds": ["container"], "source_path": "nextflow.config", "includes": [], "signals": ["container-keys"] },
    { "name": "arm64", "kinds": ["container"], "source_path": "nextflow.config", "includes": [], "signals": ["container-keys"] },
    { "name": "emulate_amd64", "kinds": ["container"], "source_path": "nextflow.config", "includes": [], "signals": ["container-keys"] },
    { "name": "singularity", "kinds": ["container"], "source_path": "nextflow.config", "includes": [], "signals": ["container-keys"] },
    { "name": "podman", "kinds": ["container"], "source_path": "nextflow.config", "includes": [], "signals": ["container-keys"] },
    { "name": "shifter", "kinds": ["container"], "source_path": "nextflow.config", "includes": [], "signals": ["container-keys"] },
    { "name": "charliecloud", "kinds": ["container"], "source_path": "nextflow.config", "includes": [], "signals": ["container-keys"] },
    { "name": "apptainer", "kinds": ["container"], "source_path": "nextflow.config", "includes": [], "signals": ["container-keys"] },
