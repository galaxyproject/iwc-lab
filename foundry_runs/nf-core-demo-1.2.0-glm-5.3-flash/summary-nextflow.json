    { "name": "test_full", "kinds": ["test"], "source_path": "nextflow.config", "includes": ["conf/test_full.config"], "signals": ["include:test-config", "sets-input-data", "params-assignment"] }
  ],
  "tools": [
    { "name": "fastqc", "version": "0.12.1", "bioconda": "bioconda::fastqc=0.12.1", "biocontainer": "quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0", "docker": null, "singularity": "https://depot.galaxyproject.org/singularity/fastqc:0.12.1--hdfd78af_0", "wave": null },
    { "name": "seqtk", "version": "1.4", "bioconda": "bioconda::seqtk=1.4", "biocontainer": "biocontainers/seqtk:1.4--he4a0461_1", "docker": null, "singularity": "https://depot.galaxyproject.org/singularity/seqtk:1.4--he4a0461_1", "wave": null },
    { "name": "multiqc", "version": "1.34", "bioconda": "bioconda::multiqc=1.34", "biocontainer": null, "docker": null, "singularity": "https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/1b/1bef8af6be88c5733461959c46ac8ef73d18f65277f62a1695d0e1633054f9c2/data", "wave": "community.wave.seqera.io/library/multiqc:1.34--db7c73dae76bc9e6" },
    { "name": "cowpy", "version": "1.1.5", "bioconda": "conda-forge::cowpy=1.1.5", "biocontainer": null, "docker": null, "singularity": "https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/1a/1a1f6ff027a12fc86ad7bb9f8781c06b6fd7c8b81a9ecde90cda09335927b0fe/data", "wave": "community.wave.seqera.io/library/cowpy:1.1.5--3db457ae1977a273" }
  ],
  "processes": [
    {
      "name": "FASTQC",
      "aliases": [],
      "in_subworkflows": ["DEMO"],
      "module_path": "modules/nf-core/fastqc/main.nf",
      "meta": {
        "description": "Run FastQC on sequenced reads",
        "keywords": ["quality control", "qc", "adapters", "fastq"],
        "authors": ["@drpatelh", "@grst", "@ewels", "@FelixKrueger"],
        "maintainers": ["@drpatelh", "@grst", "@ewels", "@FelixKrueger"],
        "tools": [
          { "name": "fastqc", "description": "FastQC gives general quality metrics about your reads. It provides information about the quality score distribution across your reads, the per base sequence content (%A/C/G/T). You get information about adapter contamination and other overrepresented sequences.", "homepage": "https://www.bioinformatics.babraham.ac.uk/projects/fastqc/", "documentation": "https://www.bioinformatics.babraham.ac.uk/projects/fastqc/Help/", "licence": ["GPL-2.0-only"], "identifier": "biotools:fastqc" }
        ],
        "input": [
          { "name": "meta", "type": "map", "description": "Groovy Map containing sample information e.g. [ id:'test', single_end:false ]" },
          { "name": "reads", "type": "file", "description": "List of input FastQ files of size 1 and 2 for single-end and paired-end data, respectively." }
        ],
        "output": [
          { "name": "html", "type": "file", "description": "FastQC report", "pattern": "*_{fastqc.html}" },
          { "name": "zip", "type": "file", "description": "FastQC report archive", "pattern": "*_{fastqc.zip}" }
        ]
      },
      "module_tests": [
        { "name": "fastqc test_fastqc", "path": "modules/nf-core/fastqc/tests/main.nf.test", "profiles": ["test", "test_single_end"], "params_overrides": {}, "execution_mode": "unknown", "assert_workflow_success": true, "snapshot": null, "prose_assertions": [] }
      ],
      "tool": "fastqc",
      "container": "${workflow.containerEngine in ['singularity', 'apptainer'] && !task.ext.singularity_pull_docker_container ? 'https://depot.galaxyproject.org/singularity/fastqc:0.12.1--hdfd78af_0' : 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'}",
      "conda": "${moduleDir}/environment.yml",
      "inputs": [
        { "name": "meta", "shape": "val(map)", "description": "Groovy Map containing sample information", "topic": null },
        { "name": "reads", "shape": "path", "description": "Input FastQ files (1 or 2 per sample)", "topic": null }
      ],
      "outputs": [
        { "name": "html", "shape": "tuple(meta, path)", "description": "FastQC report", "topic": null },
        { "name": "zip", "shape": "tuple(meta, path)", "description": "FastQC report archive", "topic": null },
        { "name": "versions_fastqc", "shape": "tuple(val, val, eval)", "description": "tool versions tuple for the versions topic", "topic": "versions" }
      ],
      "when": "task.ext.when == null || task.ext.when",
      "script_summary": "Renames input reads to <prefix>.<ext> via symlinks and runs FastQC on them with configured threads/memory, producing an HTML report and a zip archive.",
      "script_excerpt": "printf \"%s %s\\n\" ${rename_to} | while read old_name new_name; do\n    [ -f \"${new_name}\" ] || ln -s $old_name $new_name\ndone\n\nfastqc \\\n    ${args} \\\n    --threads ${task.cpus} \\\n    ${fastqc_memory_arg} \\\n    ${renamed_files}\n",
      "publish_dir": null
    },
    {
      "name": "SEQTK_TRIM",
      "aliases": [],
      "in_subworkflows": ["DEMO"],
      "module_path": "modules/nf-core/seqtk/trim/main.nf",
      "meta": {
        "description": "Trim low quality bases from FastQ files",
        "keywords": ["trimfq", "fastq", "seqtk"],
        "authors": [],
        "maintainers": [],
        "tools": [
          { "name": "seqtk", "description": "Seqtk is a fast and lightweight tool for processing sequences in the FASTA or FASTQ format", "homepage": "https://github.com/lh3/seqtk", "documentation": "https://docs.csc.fi/apps/seqtk/", "tool_dev_url": "https://github.com/lh3/seqtk", "licence": ["MIT"], "identifier": "biotools:seqtk" }
        ],
        "input": [
          { "name": "meta", "type": "map", "description": "Groovy Map containing sample information e.g. [ id:'test', single_end:false ]" },
          { "name": "reads", "type": "file", "description": "List of input FastQ files" }
        ],
        "output": [
          { "name": "reads", "type": "file", "description": "Filtered FastQ files", "pattern": "*.{fastq.gz}" }
        ]
      },
      "module_tests": [
        { "name": "seqtk_trim test_seqtk_trim", "path": "modules/nf-core/seqtk/trim/tests/main.nf.test", "profiles": ["test"], "params_overrides": {}, "execution_mode": "unknown", "assert_workflow_success": true, "snapshot": null, "prose_assertions": [] }
      ],
      "tool": "seqtk",
      "container": "${ workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ? 'https://depot.galaxyproject.org/singularity/seqtk:1.4--he4a0461_1' : 'biocontainers/seqtk:1.4--he4a0461_1' }",
      "conda": "${moduleDir}/environment.yml",
      "inputs": [
        { "name": "meta", "shape": "val(map)", "description": "Groovy Map containing sample information", "topic": null },
        { "name": "reads", "shape": "path", "description": "Input FastQ files", "topic": null }
      ],
      "outputs": [
        { "name": "reads", "shape": "tuple(meta, path)", "description": "Trimmed FastQ files", "topic": null },
        { "name": "versions_seqtk", "shape": "tuple(val, val, eval)", "description": "tool versions tuple for the versions topic", "topic": "versions" }
      ],
      "when": "task.ext.when == null || task.ext.when",
      "script_summary": "Runs seqtk trimfq on each input FastQ file and gzips the trimmed output as <prefix>_<basename>.",
      "script_excerpt": "printf \"%s\\n\" $reads | while read f;\ndo\n    seqtk \\\n        trimfq \\\n        $args \\\n        $f \\\n        | gzip --no-name > ${prefix}_$(basename $f)\ndone\n",
      "publish_dir": null
    },
    {
      "name": "COWPY",
      "aliases": [],
      "in_subworkflows": ["DEMO"],
      "module_path": "modules/local/cowpy/main.nf",
      "meta": null,
      "module_tests": [],
      "tool": "cowpy",
      "container": "${workflow.containerEngine in ['singularity', 'apptainer'] && !task.ext.singularity_pull_docker_container ? 'https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/1a/1a1f6ff027a12fc86ad7bb9f8781c06b6fd7c8b81a9ecde90cda09335927b0fe/data' : 'community.wave.seqera.io/library/cowpy:1.1.5--3db457ae1977a273'}",
      "conda": "${moduleDir}/environment.yml",
      "inputs": [],
      "outputs": [
        { "name": "txt", "shape": "path", "description": "cowpy.txt - a cow saying nf-core rules!", "topic": null },
        { "name": "versions_cowpy", "shape": "tuple(val, val, val)", "description": "tool versions tuple for the versions topic", "topic": "versions" }
      ],
      "when": "task.ext.when == null || task.ext.when",
      "script_summary": "Pipes the text 'nf-core rules!' into cowpy and writes the ASCII-art cow output to cowpy.txt.",
      "script_excerpt": "echo \"nf-core rules!\" | cowpy ${args} > cowpy.txt\n",
      "publish_dir": null
    },
    {
      "name": "MULTIQC",
      "aliases": [],
      "in_subworkflows": ["DEMO"],
      "module_path": "modules/nf-core/multiqc/main.nf",
      "meta": {
        "description": "MultiQC aggregates results from bioinformatics analyses across many samples into a single report",
        "keywords": ["quality control", "qc", "multiqc", "report", "aggregation", "visualisation"],
        "authors": ["@abhi18av", "@bunop", "@joseespinosa", "@matthdsm", "@jfy133"],
        "maintainers": ["@abhi18av", "@bunop", "@joseespinosa", "@matthdsm", "@jfy133"],
        "tools": [
          { "name": "multiqc", "description": "MultiQC searches a given directory and analyses file names for recognised tool output and compiles the results into a single HTML report.", "homepage": "https://github.com/ewels/MultiQC", "documentation": "https://multiqc.info/", "tool_dev_url": "https://github.com/ewels/MultiQC", "licence": ["GPL-3.0-or-later"], "identifier": "biotools:multiqc" }
        ],
        "input": [
          { "name": "meta", "type": "map", "description": "Groovy Map containing sample information" },
          { "name": "multiqc_files", "type": "file", "description": "List of files to be included in the MultiQC report" },
          { "name": "multiqc_config", "type": "file", "description": "MultiQC config file" },
          { "name": "multiqc_logo", "type": "file", "description": "MultiQC logo file" },
          { "name": "replace_names", "type": "file", "description": "File containing sample name replacement patterns" },
          { "name": "sample_names", "type": "file", "description": "File containing sample names to use" }
        ],
        "output": [
          { "name": "report", "type": "file", "description": "MultiQC report file", "pattern": "*_{multiqc.html}" },
          { "name": "data", "type": "file", "description": "MultiQC data directory", "pattern": "*_{multiqc_data}" },
          { "name": "plots", "type": "file", "description": "MultiQC plots directory (optional)", "pattern": "*_{multiqc_plots}" }
        ]
      },
      "module_tests": [
        { "name": "multiqc test_multiqc", "path": "modules/nf-core/multiqc/tests/main.nf.test", "profiles": ["test"], "params_overrides": {}, "execution_mode": "unknown", "assert_workflow_success": true, "snapshot": null, "prose_assertions": [] }
      ],
      "tool": "multiqc",
