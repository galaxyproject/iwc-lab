    },
    "2": {
      "id": 2,
      "name": "gtf",
      "type": "data_input",
      "label": "gtf",
      "annotation": "Reference gene annotation file in GTF format",
      "tool_state": "{\"name\": \"gtf\", \"format\": [\"gtf\"]}",
      "position": {
        "top": 200,
        "left": 0
      },
      "input_connections": {},
      "inputs": [
        {
          "name": "gtf",
          "description": ""
        }
      ],
      "outputs": [],
      "workflow_outputs": [],
      "post_job_actions": {}
    },
    "3": {
      "id": 3,
      "name": "barcode_whitelist",
      "type": "data_input",
      "label": "barcode_whitelist",
      "annotation": "Whitelist of known cell barcodes for error correction (optional)",
      "tool_state": "{\"name\": \"barcode_whitelist\", \"optional\": true, \"format\": [\"txt\"]}",
      "position": {
        "top": 300,
        "left": 0
      },
      "input_connections": {},
      "inputs": [
        {
          "name": "barcode_whitelist",
          "description": ""
