    },
    "1": {
      "id": 1,
      "name": "fasta",
      "type": "data_input",
      "label": "fasta",
      "annotation": "Reference genome sequence in FASTA format",
      "tool_state": "{\"name\": \"fasta\", \"format\": [\"fasta\"]}",
      "position": {
        "top": 100,
        "left": 0
      },
      "input_connections": {},
      "inputs": [
        {
          "name": "fasta",
          "description": ""
        }
      ],
      "outputs": [],
