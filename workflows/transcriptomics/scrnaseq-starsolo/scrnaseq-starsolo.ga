    "4": {
      "id": 4,
      "name": "toolshed.g2.bx.psu.edu/repos/iuc/rna_starsolo/rna_starsolo/2.7.11b+galaxy3",
      "type": "tool",
      "label": "starsolo",
      "annotation": "Align reads, demultiplex cell barcodes and UMIs, and quantify gene expression",
      "tool_state": "{\"__page__\": 0, \"algo\": {\"params\": {\"settingsType\": \"default\"}}, \"chimOutType\": \"\", \"outWig\": {\"outWigStrand\": \"false\", \"outWigType\": \"None\"}, \"refGenomeSource\": {\"geneSource\": \"history\", \"genomeFastaFiles\": {\"__class__\": \"ConnectedValue\"}, \"genomeSAindexNbases\": 12, \"sjdbGTFfeatureExon\": \"exon\", \"sjdbGTFfile\": {\"__class__\": \"ConnectedValue\"}, \"sjdbOverhang\": 100}, \"sc\": {\"input_types\": {\"input_collection\": {\"__class__\": \"ConnectedValue\"}, \"use\": \"list_paired\"}, \"params\": {\"chemistry\": \"Cv2\"}, \"soloBarcodeReadLength\": true, \"soloCBmatchWLtype\": \"1MM_multi\", \"soloCBwhitelist\": {\"__class__\": \"ConnectedValue\"}, \"solo_type\": \"CB_UMI_Simple\", \"umidedup\": {\"soloUMIdedup\": \"1MM_CR\", \"soloUMIfiltering\": \"-\"}}, \"solo\": {\"filter\": {\"filter_type\": \"cellranger2\", \"n_expected\": 5000, \"max_perc\": 0.99, \"max_min_ratio\": 10.0, \"output_raw\": true}, \"outSAMattributes\": [\"NH\", \"HI\", \"AS\", \"nM\", \"GX\", \"GN\", \"CB\", \"UB\"], \"outSAMmapqUnique\": 60, \"outSAMunmapped\": false, \"quantModeGene\": true, \"soloFeatures\": [\"Gene$\"], \"soloOutFormatFeaturesGeneField3\": \"Gene Expression\", \"soloStrand\": \"Forward\", \"wasp_conditional\": {\"waspOutputMode\": \"\"}}}",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/iuc/rna_starsolo/rna_starsolo/2.7.11b+galaxy3",
      "tool_version": "2.7.11b+galaxy3",
      "tool_shed_repository": {
        "name": "rna_starsolo",
        "changeset_revision": "9b1940be9da1",
        "owner": "iuc",
        "tool_shed": "toolshed.g2.bx.psu.edu"
      },
      "position": {
        "top": 0,
        "left": 220
      },
      "input_connections": {
        "refGenomeSource|genomeFastaFiles": [
          {
            "id": 1,
            "output_name": "output"
          }
        ],
        "refGenomeSource|sjdbGTFfile": [
          {
            "id": 2,
            "output_name": "output"
          }
        ],
        "sc|input_types|input_collection": [
          {
            "id": 0,
            "output_name": "output"
          }
        ],
        "sc|soloCBwhitelist": [
          {
            "id": 3,
            "output_name": "output"
          }
        ]
      },
      "inputs": [],
      "outputs": [],
      "workflow_outputs": [
        {
          "label": "Raw Gene Expression Matrix",
          "output_name": "output_matrix"
        },
        {
          "label": "Cell Barcodes",
          "output_name": "output_barcodes"
        },
        {
          "label": "Gene Features",
          "output_name": "output_genes"
        },
        {
          "label": "Filtered Gene Expression Matrix",
          "output_name": "output_matrix_filtered"
        },
        {
          "label": "Filtered Cell Barcodes",
          "output_name": "output_barcodes_filtered"
        },
        {
          "label": "Filtered Gene Features",
          "output_name": "output_genes_filtered"
        },
        {
          "label": "STARsolo Summary",
          "output_name": "output_stats"
        }
      ],
      "post_job_actions": {}
    },
    "5": {
      "id": 5,
      "name": "toolshed.g2.bx.psu.edu/repos/iuc/multiqc/multiqc/1.35+galaxy4",
      "type": "tool",
      "label": "multiqc",
      "annotation": "Aggregate STARsolo alignment and quantification quality metrics into an interactive HTML report",
      "tool_state": "{\"__page__\": 0, \"comment\": \"\", \"export\": false, \"flat\": false, \"png_plots\": false, \"results\": [{\"software_cond\": {\"software\": \"star\", \"output\": [{\"type\": {\"type\": \"log\", \"input\": {\"__class__\": \"ConnectedValue\"}}}, {\"type\": {\"type\": \"genecounts\", \"input\": {\"__class__\": \"ConnectedValue\"}}}]}}], \"title\": \"\", \"image_content_input\": null}",
      "tool_id": "toolshed.g2.bx.psu.edu/repos/iuc/multiqc/multiqc/1.35+galaxy4",
      "tool_version": "1.35+galaxy4",
      "tool_shed_repository": {
        "name": "multiqc",
        "changeset_revision": "97255f6fdf7e",
        "owner": "iuc",
        "tool_shed": "toolshed.g2.bx.psu.edu"
      },
      "position": {
        "top": 0,
        "left": 440
      },
      "input_connections": {
        "results_0|software_cond|output_0|type|input": [
          {
            "id": 4,
            "output_name": "output_log"
          }
        ],
        "results_0|software_cond|output_1|type|input": [
          {
            "id": 4,
            "output_name": "reads_per_gene"
          }
        ]
      },
      "inputs": [],
      "outputs": [],
