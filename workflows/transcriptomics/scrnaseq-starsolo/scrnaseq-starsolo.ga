{
  "name": "Single-Cell RNA-Seq Fastq to Gene Matrix (STARsolo and MultiQC)",
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "annotation": "This workflow is a Galaxy translation of the nf-core/scrnaseq pipeline (https://nf-co.re/scrnaseq).\nIt performs single-cell RNA-seq alignment, demultiplexing, and barcode error correction\nusing STARsolo to generate raw and filtered gene expression matrices, and aggregates\nquality control reports with MultiQC.\n",
  "tags": [
    "single-cell",
    "transcriptomics",
    "10x-genomics",
    "star",
    "nf-core",
    "nf-core/scrnaseq"
  ],
  "license": "MIT",
  "release": "0.1",
  "uuid": "155dfb35-7f3f-4401-9902-2144a5c5e317",
  "creator": [
    {
      "name": "nf-core",
      "url": "https://nf-co.re/scrnaseq",
      "class": "Organization"
    },
    {
      "name": "Rand Zoabi",
      "email": "rand.zoabi@rz.uni-freiburg.de",
      "class": "Person"
    },
    {
      "name": "Intergalactic Workflow Commission",
      "url": "https://github.com/galaxyproject/iwc",
      "class": "Organization"
    }
  ],
  "comments": [],
  "steps": {
    "0": {
      "id": 0,
      "name": "reads",
      "type": "data_collection_input",
      "label": "reads",
      "annotation": "FASTQ collection containing cell barcode and UMI (Read 1) paired with cDNA read (Read 2)",
      "tool_state": "{\"name\": \"reads\", \"format\": [\"fastqsanger.gz\"], \"collection_type\": \"list:paired\"}",
      "position": {
        "top": 0,
        "left": 0
      },
      "input_connections": {},
      "inputs": [
        {
          "name": "reads",
          "description": ""
        }
